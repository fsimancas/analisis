[Unit]
Description=FAIS native Redis event bus
After=network.target

[Service]
Type=simple
User=fais
Group=fais
ExecStart=/opt/fais/runtime/redis/bin/redis-server /etc/fais/redis.conf
ExecStop=/opt/fais/runtime/redis/bin/redis-cli -h 127.0.0.1 -p 6379 shutdown
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fais/redis
UMask=0027

[Install]
WantedBy=multi-user.target
