FAIS_ENVIRONMENT=production
FAIS_DATABASE_PATH=/var/lib/fais/fais.sqlite3
FAIS_INBOX_PATH=/var/lib/fais/inbox
FAIS_REDIS_URL=redis://127.0.0.1:6379/0
FAIS_CORS_ORIGINS=https://sports.example.com
FAIS_LOG_LEVEL=INFO
FAIS_AUTH_SECRET=replace-with-at-least-32-random-bytes
FAIS_ACCESS_TOKEN_MINUTES=480
# Optional outbound notification channel (must be HTTPS in production).
# FAIS_ALERT_WEBHOOK_URL=https://alerts.example.com/fais
# FAIS_ALERT_WEBHOOK_TOKEN=replace-with-provider-token
